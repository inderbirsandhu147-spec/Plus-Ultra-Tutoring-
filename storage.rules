rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function verified() { return request.auth != null && (request.auth.token.email_verified == true || ('email' in request.auth.token && request.auth.token.email.matches('.*@students[.]plusultra[.]app'))); }
    function isTutor(id) {
      return verified() && request.auth.uid == id
        && firestore.get(/databases/(default)/documents/tutors/$(id)).data.active == true;
    }
    function task(id) { return firestore.get(/databases/(default)/documents/assignments/$(id)).data; }
    function owner(id) { return verified() && task(id).studentEmail == request.auth.token.email.lower(); }
    function validFile() {
      return request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['application/pdf','image/jpeg','image/png','image/webp','text/plain','application/vnd.openxmlformats-officedocument.wordprocessingml.document'];
    }
    match /work/{tutorId}/{assignmentId}/{folder}/{fileName} {
      allow read: if task(assignmentId).tutorId == tutorId && (isTutor(tutorId) || owner(assignmentId));
      allow create: if task(assignmentId).tutorId == tutorId && validFile()
        && ((folder == 'resources' && isTutor(tutorId))
          || (folder == 'submissions' && owner(assignmentId) && task(assignmentId).status == 'assigned'));
      allow update: if false;
      allow delete: if isTutor(tutorId) && task(assignmentId).tutorId == tutorId;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
