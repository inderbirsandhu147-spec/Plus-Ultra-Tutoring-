rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && (request.auth.token.email_verified == true
        || ('email' in request.auth.token && request.auth.token.email.matches('.*@students[.]plusultra[.]app')));
    }
    function tutor() {
      return verified()
        && exists(/databases/$(database)/documents/tutors/$(request.auth.uid))
        && get(/databases/$(database)/documents/tutors/$(request.auth.uid)).data.active == true;
    }
    function owns(d) { return tutor() && d.tutorId == request.auth.uid; }
    function learner(email) { return verified() && email == request.auth.token.email.lower(); }
    function studentExists(id) {
      return exists(/databases/$(database)/documents/students/$(id));
    }
    function enrolled(d) {
      let s = get(/databases/$(database)/documents/students/$(d.studentId)).data;
      return s.tutorId == request.auth.uid && s.email == d.studentEmail;
    }
    function validStudent(d) {
      return d.keys().hasAll(['name', 'email', 'level', 'subjects', 'goals', 'tutorId', 'color', 'createdAt'])
        && d.keys().hasOnly(['name', 'email', 'level', 'subjects', 'goals', 'tutorId', 'color', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.email is string && d.email == d.email.lower() && d.email.size() <= 254
        && d.level is string && d.level.size() <= 80
        && d.subjects is list && d.subjects.size() > 0 && d.subjects.size() <= 20
        && d.goals is list && d.goals.size() <= 100
        && d.color in ['lilac', 'peach', 'blue', 'pink', 'green']
        && d.createdAt is string;
    }
    function validAssignment(d) {
      return d.keys().hasAll(['tutorId','studentId','studentEmail','title','subject','dueDate','kind','instructions','link','goalId','status','attachments','submissionFiles','response','feedback','score','submittedAt','reviewedAt','createdAt'])
        && d.keys().hasOnly(['tutorId','studentId','studentEmail','title','subject','dueDate','kind','instructions','link','goalId','status','attachments','submissionFiles','response','feedback','score','submittedAt','reviewedAt','createdAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 160
        && d.subject is string && d.subject.size() <= 80
        && d.instructions is string && d.instructions.size() <= 10000
        && d.dueDate is string && d.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.kind in ['response','simple'] && d.status in ['assigned','submitted','completed']
        && d.response is string && d.response.size() <= 20000
        && d.feedback is string && d.feedback.size() <= 10000
        && d.link is string && d.link.size() <= 2000 && d.goalId is string
        && d.attachments is list && d.attachments.size() <= 20
        && d.submissionFiles is list && d.submissionFiles.size() <= 1
        && (d.score == null || (d.score is number && d.score >= 0 && d.score <= 100))
        && (d.submittedAt == null || d.submittedAt is string)
        && (d.reviewedAt == null || d.reviewedAt is string) && d.createdAt is string;
    }
    // Create this record from the Firebase console or a trusted Admin SDK only.
    // No browser account can grant itself tutor privileges.
    match /tutors/{id} {
      allow get: if verified() && request.auth.uid == id;
      allow list, create, update, delete: if false;
    }
    match /students/{id} {
      allow read: if owns(resource.data) || learner(resource.data.email);
      allow create: if owns(request.resource.data) && validStudent(request.resource.data);
      allow update: if owns(resource.data) && validStudent(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','level','subjects','color','goals']);
      allow delete: if false;
    }
    match /assignments/{id} {
      allow read: if owns(resource.data) || learner(resource.data.studentEmail);
      allow create: if owns(request.resource.data) && validAssignment(request.resource.data)
        && studentExists(request.resource.data.studentId) && enrolled(request.resource.data)
        && request.resource.data.status == 'assigned'
        && request.resource.data.response == '' && request.resource.data.feedback == ''
        && request.resource.data.score == null && request.resource.data.submissionFiles.size() == 0;
      allow update: if validAssignment(request.resource.data) && (
        (owns(resource.data)
          && request.resource.data.tutorId == resource.data.tutorId
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.studentEmail == resource.data.studentEmail
          && request.resource.data.createdAt == resource.data.createdAt)
        || (learner(resource.data.studentEmail)
          && resource.data.status == 'assigned'
          && request.resource.data.status == 'submitted'
          && request.resource.data.submittedAt is string
          && (resource.data.kind == 'simple' || request.resource.data.response.size() > 0 || request.resource.data.submissionFiles.size() > 0)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['response','submissionFiles','status','submittedAt']))
      );
      allow delete: if false;
    }
    // Session observations and scheduling information are tutor-only documents.
    match /notes/{id} {
      allow read: if owns(resource.data);
      allow create, update: if owns(request.resource.data)
        && (request.method == 'create' || (owns(resource.data)
          && request.resource.data.studentId == resource.data.studentId))
        && request.resource.data.keys().hasOnly(['tutorId','studentId','date','text'])
        && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.tutorId == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 10000
        && request.resource.data.date is string;
      allow delete: if false;
    }
    match /sessions/{id} {
      allow read: if owns(resource.data) || learner(get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.email);
      allow create, update: if owns(request.resource.data)
        && (request.method == 'create' || (owns(resource.data)
          && request.resource.data.studentId == resource.data.studentId))
        && request.resource.data.keys().hasOnly(['tutorId','studentId','subject','topic','date','time','duration'])
        && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.tutorId == request.auth.uid
        && request.resource.data.subject is string && request.resource.data.subject.size() <= 80
        && request.resource.data.topic is string && request.resource.data.topic.size() <= 200
        && request.resource.data.date is string && request.resource.data.time is string
        && request.resource.data.duration is number && request.resource.data.duration >= 10 && request.resource.data.duration <= 240;
      allow delete: if false;
    }
    match /assessments/{id} {
      allow read: if owns(resource.data) || learner(resource.data.studentEmail);
      allow create, update: if owns(request.resource.data)
        && (request.method == 'create' || (owns(resource.data)
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.studentEmail == resource.data.studentEmail
          && request.resource.data.assignmentId == resource.data.assignmentId)) && enrolled(request.resource.data)
        && request.resource.data.keys().hasOnly(['tutorId','studentId','studentEmail','title','date','score','assignmentId'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 160
        && request.resource.data.date is string && request.resource.data.assignmentId is string
        && request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 100;
      allow delete: if false;
    }
    // Everything not explicitly allowed above stays private.
    match /{document=**} { allow read, write: if false; }
  }
}
